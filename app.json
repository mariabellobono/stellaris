{
  "expo": {
    "name": "Stellaris",
    "slug": "stellaris",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "stellaris",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stellaris.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Stellaris usa la tua posizione per calcolare la visibilità del cielo notturno e il meteo astronomico locale.",
        "NSCalendarsUsageDescription": "Stellaris ti permette di aggiungere promemoria per gli eventi astronomici al tuo calendario."
      }
    },
    "android": {
      "package": "com.stellaris.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#0B0D17"
      },
      "config": {
        "googleMaps": {
          "apiKey": ""
        }
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "READ_CALENDAR",
        "WRITE_CALENDAR",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-calendar",
        {
          "calendarPermission": "Stellaris usa il calendario per salvare i promemoria degli eventi celesti."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Stellaris usa la posizione per calcolare la copertura nuvolosa locale."
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0B0D17"
        }
      ],
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "01d0b6b3-c2f5-4d2a-bcdb-d4c4d84b3948"
      }
    }
  }
}
